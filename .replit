modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "BlazeOS"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "env-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "route-health"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "bundle-integrity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ci"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-db"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-integration"

[[workflows.workflow]]
name = "BlazeOS"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/blazeos dev"
waitForPort = 5000

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server dev"
waitForPort = 8080

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build-frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/blazeos run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "env-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:env"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "route-health"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:routes"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "bundle-integrity"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:bundle"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ci"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run ci"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "check-db"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:db"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "check-integration"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:integration"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_database:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19876
externalPort = 3001

[[ports]]
localPort = 24517
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SUPABASE_URL = "https://zlizxldttghilrwjyidr.supabase.co"
BASE_PATH = "/"
VITE_SUPABASE_URL = "https://zlizxldttghilrwjyidr.supabase.co"
